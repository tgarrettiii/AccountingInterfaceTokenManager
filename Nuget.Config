<?xml version="1.0" encoding="utf-8"?>
<configuration>

    <!--
        Used to specify the default Sources for list, install and update.
        See: nuget.exe help list
        See: nuget.exe help install
        See: nuget.exe help update
    -->
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="TgArtifactory" value="C:\TgArtifactory" protocolVersion="3" allowInsecureConnections="True" />
        <add key="EP-Artifactory-Core" value="http://artifactory.ep.corp/artifactory/api/nuget/EPCoreNuget" allowInsecureConnections="True" />
        <add key="EP-Artifactory-Common" value="http://artifactory.ep.corp/artifactory/api/nuget/EPCommonNuget" allowInsecureConnections="True" />
        <add key="EP-Artifactory-Common" value="http://artifactory.ep.corp/artifactory/api/nuget/EPCommonNuget" allowInsecureConnections="True" />
        
    </packageSources>

</configuration>